        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"images\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by_device_id\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id), \"blob_id\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"source\" TEXT NOT NULL, \"captured_at\" INTEGER NULL, \"edits_json\" TEXT NOT NULL, \"derived_from_json\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by_device_id\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"name_is_default\" INTEGER NOT NULL CHECK (\"name_is_default\" IN (0, 1)), \"size_kind\" TEXT NOT NULL DEFAULT 'none', \"ratio_w\" REAL NULL, \"ratio_h\" REAL NULL, \"width\" REAL NULL, \"height\" REAL NULL, \"unit\" TEXT NULL, \"start_notes\" TEXT NOT NULL DEFAULT '', \"reference_image_id\" TEXT NULL REFERENCES images (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "image_edit_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_edit_history\" (\"image_id\" TEXT NOT NULL REFERENCES images (id), \"seq\" INTEGER NOT NULL, \"edits_json\" TEXT NOT NULL, PRIMARY KEY (\"image_id\", \"seq\"));"
        }
      ]
    },
    {
      "name": "image_edit_cursor",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_edit_cursor\" (\"image_id\" TEXT NOT NULL REFERENCES images (id), \"seq\" INTEGER NOT NULL, PRIMARY KEY (\"image_id\"));"
        }
      ]
    },
    {
      "name": "app_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "view_prefs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"view_prefs\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by_device_id\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id), \"prefs_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"kind\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"drive_file_id\" TEXT NOT NULL, \"remote_version\" INTEGER NOT NULL, \"synced_hash\" TEXT NULL, \"held_json\" TEXT NULL, PRIMARY KEY (\"kind\", \"record_id\"));"
        }
      ]
    },
    {
      "name": "blob_sync",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"blob_sync\" (\"blob_id\" TEXT NOT NULL, \"drive_file_id\" TEXT NULL, \"thumb_file_id\" TEXT NULL, \"state\" TEXT NOT NULL, PRIMARY KEY (\"blob_id\"));"
        }
      ]
    },
    {
      "name": "sync_conflicts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_conflicts\" (\"kind\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"drive_file_id\" TEXT NOT NULL, \"remote_json\" TEXT NOT NULL, \"remote_version\" INTEGER NOT NULL, \"detected_at\" INTEGER NOT NULL, PRIMARY KEY (\"kind\", \"record_id\"));"
        }
      ]
    },
    {
